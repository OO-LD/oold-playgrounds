{
  "name": "oold-azure-providers",
  "version": "0.1.0",
  "description": "Azure OpenAI and Azure AI Foundry Anthropic providers for jupyterlite-ai",
  "keywords": [
    "jupyter",
    "jupyterlab",
    "jupyterlab-extension",
    "jupyterlite"
  ],
  "license": "BSD-3-Clause",
  "private": true,
  "main": "lib/index.js",
  "types": "lib/index.d.ts",
  "files": [
    "lib/**/*.{d.ts,js,js.map}",
    "schema/*.json"
  ],
  "scripts": {
    "build": "npm run build:lib && npm run build:labextension",
    "build:lib": "tsc",
    "build:labextension": "jupyter-builder build .",
    "clean": "rimraf lib labextension tsconfig.tsbuildinfo"
  },
  "dependencies": {
    "@ai-sdk/anthropic": "4.0.71",
    "@ai-sdk/azure": "4.0.90",
    "@jupyterlab/application": "^4.5.8",
    "@jupyterlab/settingregistry": "^4.5.8",
    "@jupyternaut/agent": "^0.20.1",
    "@lumino/coreutils": "^2.2.1"
  },
  "devDependencies": {
    "@jupyter/builder": "^1.2.2",
    "rimraf": "^5.0.1",
    "typescript": "~5.8.0"
  },
  "jupyterlab": {
    "extension": true,
    "outputDir": "labextension",
    "schemaDir": "schema",
    "sharedPackages": {
      "@jupyternaut/agent": {
        "bundled": false,
        "singleton": true
      }
    },
    "_build": {
      "load": "static/remoteEntry.a2e7f9f329028427.js",
      "extension": "./extension"
    }
  }
}
